--==================== FISIOLOGIA ====================
local function atualizarFisio(dt)
    if S.sexo or S.prelim or S.masturbando then
        local mult = S.prelim and 0.45 or (S.masturbando and 0.55 or 1)
        local resist = 1 - (S.tesao/100)*0.70
        local ganho = S.vel*0.85*(0.55+S.amp)*mult
        S.tesao = math.min(100, S.tesao + dt*ganho*resist*(1+S.gozadas*0.06))
        if S.tesao >= 100 then S.tesao = 0; gozar() end
    else
        S.tesao = math.max(0, S.tesao - dt*7)
    end
    local a = S.tesao/100
    S.blush   = aprox(S.blush,   a, 1.7, dt)
    S.molhada = aprox(S.molhada, math.min(1, a*1.5), 1.3, dt)
    S.suor    = aprox(S.suor,    clamp((a-0.32)/0.68,0,1), 1.2, dt)
    S.trem    = a*a
    S.ereccao = aprox(S.ereccao, S.sexo and 1 or 0.25, 0.9, dt)
    S.revirar = math.max(0, S.revirar - dt*0.75)

    local bTotal = clamp(S.blush + S.vergonha*0.85, 0, 1.3)
    if S.realBlush then
        for _,e in ipairs(S.peleParts) do
            if e.p.Parent then e.p.Color = clc(e.base, COR.peleBlush, bTotal*0.72*e.f) end
        end
        for _,n in ipairs(S.nips) do
            if n.p.Parent then
                n.p.Color = clc(n.cor, COR.mamiloDuro, clamp(bTotal,0,1))
                n.p.Size = n.base*(1 + clamp(bTotal,0,1)*0.40)
            end
        end
        if S.clit and S.clit.Parent then
            S.clit.Size = V3(0.075,0.075,0.082)*(1+clamp(bTotal,0,1)*1.1)
            S.clit.Color = clc(COR.clit, Color3.fromRGB(228,86,104), clamp(bTotal,0,1))
        end
        if S.boneca then
            for _,l in ipairs(S.boneca.vulva.parts) do
                if l.Parent and (l.Name=="Labio" or l.Name=="LabioInt") then
                    l.Color = clc(l.Name=="Labio" and COR.labio or COR.interno, COR.labioQuente, clamp(bTotal,0,1))
                end
            end
        end
    end
    if S.realSuor then
        for _,pe in ipairs(S.particulas) do if pe.Parent then pe.Rate = S.suor*7*S.qual end end
    end
    local calc = S.roupa.calcinha
    if calc and calc.on and calc.mancha and calc.mancha.Parent then
        calc.mancha.Size = V3(0.10 + S.molhada*0.42, 0.06 + S.molhada*0.30, 0.10)
        calc.mancha.Transparency = 0.15 + (1-S.molhada)*0.5
    end
end

local function aplicarJigs(dt)
    if not S.boneca then return end
    local cur = S.boneca.hrp.CFrame
    local prev = S.lastPos or cur
    local acc = (cur.Position - prev.Position)/math.max(dt,1e-4)
    S.lastPos = cur
    S.accSm = S.accSm:Lerp(acc, math.min(1, dt*20))
    local accL = cur:VectorToObjectSpace(S.accSm)
    local gravL = cur:VectorToObjectSpace(V3(0,-4.2,0))
    for i=#S.jigs,1,-1 do
        local j = S.jigs[i]
        if not (j.w and j.w.Parent) then table.remove(S.jigs,i)
        else
            local f = j.off*-j.k - j.vel*j.d + (gravL-accL)*j.m
            j.vel = j.vel + f*dt; j.off = j.off + j.vel*dt
            local m = j.off.Magnitude
            if m > j.lim then j.off = j.off*(j.lim/m) end
            j.w.C0 = CFrame.new(j.off) * j.base
        end
    end
end

--==================== IK DOS PES ====================
local function atualizarPes(dt)
    local b = S.boneca
    if not (b and S.ikPes) then return end
    local pose = POSES[S.poseIdx]
    if S.sexo and not (pose and pose.pes) then return end
    local cf = b.hrp.CFrame
    for _, lado in ipairs({-1,1}) do
        local nm = lado>0 and "D" or "E"
        local m1, m2 = b.motores["quadril"..nm], b.motores["joelho"..nm]
        local Jw = (cf * CFrame.new(lado*0.48,-0.62,0)).Position
        local res = WS:Raycast(Jw + V3(0,0.5,0), V3(0,-5.0,0))
        local alvoMundo = res and (res.Position + V3(0,0.28,0))
            or (Jw + V3(0, -(LEN_COXA+LEN_CANELA-0.10), 0))
        local J = V3(lado*0.48,-0.62,0)
        local T = cf:PointToObjectSpace(alvoMundo)
        local pole = J + V3(lado*0.35, 0.15, -1.6)
        setIK(m1, m2, J, T, LEN_COXA, LEN_CANELA, pole)
    end
end

--==================== MAOS ====================
local function atualizarMaos(dt)
    local b = S.boneca; if not b then return end
    local modo = S.maos
    if modo=="livre" and S.autoCobrir and S.vergonha > 0.55 and not S.sexo and not S.masturbando then
        modo = "cobrir"
    end
    if modo=="livre" then
        for _, d in ipairs(S.dedos) do if d.w.Parent then d.w.C0 = d.base end end
        for _, s in ipairs(S.seios) do
            if s.p.Parent then s.p.Size = s.p.Size:Lerp(s.base, math.min(1,dt*5)) end
        end
        return
    end
    for _, lado in ipairs({-1,1}) do
        local nm = lado>0 and "D" or "E"
        local m1, m2 = b.motores["braco"..nm], b.motores["cotovelo"..nm]
        local J = V3(lado*0.80, 0.72, 0)
        local T
        if modo=="peito" or modo=="cobrir" then
            T = V3(lado*0.40, 0.26, modo=="cobrir" and -0.86 or -0.82)
        elseif modo=="bunda" then T = V3(lado*0.48, -0.60, 0.62)
        else T = V3(lado*0.55, -0.30, -0.55) end
        setIK(m1, m2, J, T, LEN_BRACO, LEN_ANTEBRACO, J + V3(lado*1.3,-0.45,0.55))
    end
    local aperto = (modo=="peito" or modo=="cobrir") and 1 or 0
    for _, s in ipairs(S.seios) do
        if s.p.Parent then
            local alvo = V3(s.base.X*(1+0.07*aperto), s.base.Y*(1+0.05*aperto), s.base.Z*(1-0.13*aperto))
            s.p.Size = s.p.Size:Lerp(alvo, math.min(1, dt*8))
        end
    end
    for _, d in ipairs(S.dedos) do
        if d.w.Parent then
            local alvo = d.base * P(modo=="peito" and 42 or (modo=="bunda" and 34 or 18), 0, 0)
            d.w.C0 = d.w.C0:Lerp(alvo, math.min(1, dt*8))
        end
    end
end

--==================== OLHOS / CABECA ====================
local function atualizarOlhos(dt)
    if not S.boneca or not S.olhosSeguem then return end
    local cam = WS.CurrentCamera; if not cam then return end
    local rel = S.boneca.cabeca.CFrame:PointToObjectSpace(cam.CFrame.Position)
    local dz = math.max(0.18, -rel.Z)
    for _, o in ipairs(S.olhos) do
        if o.w.Parent then
            local tx = clamp((rel.X - o.ex)/dz, -1.2, 1.2)*0.050
            local ty = clamp((rel.Y - o.ey)/dz, -1.2, 1.2)*0.042
            if S.revirar > 0 then tx = tx*0.15; ty = 0.048 end
            o.ox = aprox(o.ox, tx, 9, dt); o.oy = aprox(o.oy, ty, 9, dt)
            o.w.C0 = o.base * CFrame.new(o.ox, o.oy, 0)
        end
    end
    local fech = clamp(S.olhoFechado, 0, 1)
    for _, pb in ipairs(S.palpebras) do
        if pb.w.Parent then
            pb.w.C0 = pb.base + V3(0, -0.11*fech, 0)
            pb.p.Size = V3(pb.baseSize.X, pb.baseSize.Y*(1-0.85*fech), pb.baseSize.Z)
        end
    end
end

local function atualizarCabeca(dt)
    if not S.boneca or S.sexo then return end
    local cab = S.boneca.motores.cabeca
    if not (cab and cab.Parent) then return end
    local pitch, yaw = 0, 0
    if S.cabecaSegue then
        local char = LP.Character
        local minhaCab = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
        if minhaCab then
            local rel = S.boneca.hrp.CFrame:PointToObjectSpace(minhaCab.Position)
            local dist = rel.Magnitude
            if dist > 0.3 and dist < 5.5 then
                yaw = -deg(atan2(rel.X, -rel.Z))
                pitch = deg(atan2(rel.Y, math.max(0.01, sqrt(rel.X^2+rel.Z^2))))
                local k = clamp((5.5-dist)/2.5, 0, 1)
                yaw, pitch = yaw*k, pitch*k
            end
        end
    end
    if S.vergonha > 0.15 then yaw = yaw + S.vergonha*16; pitch = pitch - S.vergonha*7 end
    if S.beijo > 0 then pitch = pitch + S.beijo*12 end
    S.cabYaw = aprox(S.cabYaw, clamp(yaw,-55,55), 7, dt)
    S.cabPitch = aprox(S.cabPitch, clamp(pitch,-28,38), 7, dt)
    cab.C0 = S.boneca.baseJ.cabeca * CFrame.Angles(rad(S.cabPitch), rad(S.cabYaw), 0)
end

--==================== VERGONHA ====================
local function atualizarVergonha(dt)
    if not (S.boneca and S.vergonhaOn) then return end
    local cam = WS.CurrentCamera
    local visto, dist = false, 99
    if cam then
        local to = S.boneca.tronco.Position - cam.CFrame.Position
        dist = to.Magnitude
        if dist > 0.5 then visto = cam.CFrame.LookVector:Dot(to.Unit) > 0.90 and dist < 50 end
    end
    S.visto = visto
    S.vistoHa = visto and 0 or (S.vistoHa + dt)
    local pelada = not (S.roupa.blusa and S.roupa.blusa.on) and not (S.roupa.calcinha and S.roupa.calcinha.on)
    local alvo = 0
    if visto then alvo = alvo + 0.55*(1 + (pelada and 0.6 or 0)) end
    if dist < 6 then alvo = alvo + 0.45 end
    if dist < 3 then alvo = alvo + 0.35 end
    if S.sexo or S.prelim then alvo = alvo*0.55 end
    S.vergonha = aprox(S.vergonha, clamp(alvo,0,1), visto and 1.1 or 0.55, dt)
    if S.vergonha > 0.75 and not S.masturbando then
        S.falaT = S.falaT + dt
        if S.falaT > 4.5 then S.falaT = 0; gemido("vergonha") end
    end
end

--==================== MASTURBACAO ====================
local function atualizarMasturbacao(dt)
    if not S.boneca or S.sexo or S.prelim or S.raiva then S.masturbando = false; return end
    if S.vistoHa > 6 and S.vistoHa < 900 then
        if not S.masturbando then
            S.masturbando = true; S.mastT = 0
            if S.roupa.calcinha and S.roupa.calcinha.on and rnd()<0.7 then tirarRoupa("calcinha") end
            gemido("mast")
        end
    elseif S.visto and S.masturbando then
        S.mastT = S.mastT + dt
        if S.mastT > 0.7 then
            S.masturbando = false; S.blush = 1; S.vergonha = 1
            gemido("vergonha")
        end
    else
        S.mastT = 0
    end
end

