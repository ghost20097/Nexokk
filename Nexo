    p.CanQuery, p.CanTouch = false,false
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = pai
    local w = Instance.new("Weld"); w.Part0, w.Part1 = pai, p
    w.C0 = c0 * (rotExtra or IDENT); w.Parent = pai
    return p, w
