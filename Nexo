local function iniciarSexo()
    if not S.boneca then criarBoneca() end
    if not S.picaOn then S.picaOn=true; criarPica() end
    S.sexo=true; S.prelim=false; S.masturbando=false; S.tesao=math.max(S.tesao,10); S.autoT=0
end
local function pararSexo()
    S.sexo=false
    if S.boneca then for sem,m in pairs(S.boneca.motores) do if m.Parent then m.C0 = S.boneca.baseJ[sem] end end end
end
local function limparTudo()
    pararSexo(); removerPica(); removerBoneca()
    if S.aura and S.aura.Parent then S.aura:Destroy() end
    if S.cama and S.cama.Parent then S.cama:Destroy() end
    for _,g in ipairs(S.gotas) do pcall(function() g:Destroy() end) end
    for _,g in ipairs(S.pocoes) do pcall(function() g:Destroy() end) end
    for _,g in ipairs(S.marcas) do pcall(function() g:Destroy() end) end
    for _,r in pairs(S.remotos) do
        if r.doll and r.doll.model then r.doll.model:Destroy() end
        if r.pica then r.pica:Destroy() end
    end
    S.gotas,S.pocoes,S.marcas,S.remotos = {},{},{},{}
    for _,c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
    S.conns={}; S.raiva=false; S.picaOn=false; S.prelim=false; S.masturbando=false
end

local function morder()
    if not S.boneca then return end
    local b = S.boneca
    if S.mordidaAlvo == "peito" then
        local s = S.seios[rnd(2) or 1]
        if s then mordida(s.p, CFrame.new(0, RAIO_SEIO*0.35, -RAIO_SEIO*0.95), 0.10) end
    elseif S.mordidaAlvo == "bunda" then
        mordida(b.tronco, CFrame.new((rnd()<0.5 and -1 or 1)*0.42, -0.50, 0.94), 0.13)
    elseif S.mordidaAlvo == "coxa" then
        mordida(b.motores.quadrilD.Part1, CFrame.new(0.28, 0, -0.36), 0.12)
    else
        mordida(b.cabeca, CFrame.new((rnd()<0.5 and -1 or 1)*0.55, -0.30, -0.10), 0.10)
    end
end

