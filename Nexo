local function peca(nome, pai, c0, tam, cor, forma, rotExtra, mat)
    local p = Instance.new("Part")
    p.Name=nome; p.Shape=forma or Enum.PartType.Ball; p.Size=tam
    p.Color=cor or COR.pele; p.Material=mat or Enum.Material.SmoothPlastic
