local function enviarNet()
    if not (S.netOn and S.boneca and S.boneca.model.Parent) then return end
    S.netId = S.netId + 1
    local mot = {}
    for nome, m in pairs(S.boneca.motores) do
        if m.Parent then mot[nome] = m.C0 end
    end
    local roupa = {}
    for nome, g in pairs(S.roupa) do roupa[nome] = g.on end
    local picaCF = S.picaWeld and (S.picaWeld.Part0.CFrame * S.picaWeld.C0) or nil
    net:FireServer("sync", {
        id = S.netId, spawn = true, cf = S.boneca.hrp.CFrame,
        mot = mot, roupa = roupa, pica = picaCF,
        sexo = S.sexo, pose = S.poseIdx, tesao = math.floor(S.tesao),
    })
end

