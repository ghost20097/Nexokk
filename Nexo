local function arrastavel(frame,handle)
    local arr,ini,sp=false,nil,nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            arr,ini,sp=true,input.Position,frame.Position
            input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then arr=false end end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not arr then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
            local d=input.Position-ini
            frame.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end)
end
