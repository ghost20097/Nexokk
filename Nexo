local function capturarEstado()
    return { boneca=S.boneca, jigs=S.jigs, peleParts=S.peleParts, nips=S.nips,
             particulas=S.particulas, roupa=S.roupa, dedos=S.dedos, olhos=S.olhos,
             palpebras=S.palpebras, seios=S.seios, clit=S.clit, canal=S.canal }
end
local function restaurarEstado(t)
    S.boneca=t.boneca; S.jigs=t.jigs; S.peleParts=t.peleParts; S.nips=t.nips
    S.particulas=t.particulas; S.roupa=t.roupa; S.dedos=t.dedos; S.olhos=t.olhos
    S.palpebras=t.palpebras; S.seios=t.seios; S.clit=t.clit; S.canal=t.canal
end

criarDollRemota = function(plr)
    local salvo = capturarEstado()
    S.jigs,S.peleParts,S.nips,S.particulas,S.roupa,S.dedos,S.olhos,S.palpebras,S.seios,S.marcas = {},{},{},{},{},{},{},{},{},{}
    criarBoneca()
    local doll = S.boneca
    local roupa = S.roupa
    restaurarEstado(salvo)
    local rec = { doll=doll, roupa=roupa, pica=nil }
    S.remotos[plr] = rec
    return rec
end

local function aplicarRemoto(plr, dados)
    if plr == LP or not dados then return end
    if dados.id and ultimoId[plr] == dados.id then return end
    ultimoId[plr] = dados.id
    local rec = S.remotos[plr]
    if dados.spawn then
        if rec and rec.doll and rec.doll.model then rec.doll.model:Destroy() end
        rec = criarDollRemota(plr)
        aviso("Boneca de "..plr.Name.." apareceu!")
    end
    rec = S.remotos[plr]
    if not (rec and rec.doll and rec.doll.model.Parent) then return end
    local d = rec.doll
    if dados.cf then d.hrp.CFrame = dados.cf end
    if dados.mot then
        for nome, c0 in pairs(dados.mot) do
            local m = d.motores[nome]
            if m and m.Parent then m.C0 = c0 end
        end
    end
    if dados.roupa then
        for nome, on in pairs(dados.roupa) do
            local g = rec.roupa[nome]
            if g then
                for _, it in ipairs(g.parts) do
                    if it.p and it.p.Parent then it.p.Transparency = on and 0 or 1 end
                end
            end
        end
    end
    if dados.pica ~= nil then
        if dados.pica and not rec.pica then
            -- pica remota simples
            local p = Instance.new("Part"); p.Name="RemotaPica"
            p.Size=V3(0.25,0.25,1.1); p.Color=COR.pica; p.Anchored=true; p.CanCollide=false; p.CanQuery=false
            p.Parent = WS; rec.pica = p
        elseif not dados.pica and rec.pica then
            rec.pica:Destroy(); rec.pica = nil
        end
        if rec.pica and dados.pica then rec.pica.CFrame = dados.pica end
    end
end

