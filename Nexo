construirRoupa = function()
    local b = S.boneca; if not b then return end
    local tr = b.tronco
    local function grupo(nome, builder)
        local g = { on=true, parts={}, builder=builder }
        S.roupa[nome] = g; builder(g, tr)
    end
    local function add(g, pai, c0, tam, cor, forma, extra, mat)
        local p,w = peca("Roupa_"..pai.Name, pai, c0, tam, cor, forma, extra, mat or Enum.Material.Fabric)
        g.parts[#g.parts+1] = { p=p, w=w }
        return p
    end

    grupo("sutia", function(g, tr)
        add(g, tr, CFrame.new(0,0.36,0), V3(1.80,0.30,0.94), COR.sutia)
        add(g, tr, CFrame.new(0,0.62,0), V3(1.78,0.16,0.92), COR.sutia)
        for _,lado in ipairs({-1,1}) do
            local seio = nil
            for _,s in ipairs(S.seios) do if s.lado==lado then seio = s.p end end
            if seio then
                add(g, seio, CFrame.new(0,-RAIO_SEIO*0.06,-RAIO_SEIO*0.22),
                    V3(RAIO_SEIO*2.08,RAIO_SEIO*2.02,RAIO_SEIO*2.25), COR.sutia)
            end
        end
    end)

    grupo("calcinha", function(g, tr)
        add(g, tr, CFrame.new(0,-0.50,0), V3(2.02,0.60,1.02), COR.calcinha)
        add(g, tr, CFrame.new(0,-0.60,-0.56), V3(0.90,0.44,0.28), COR.calcinha)
        g.mancha = add(g, tr, CFrame.new(0,-0.60,-0.68), V3(0.42,0.26,0.10),
                       Color3.fromRGB(220,205,225), nil, nil, Enum.Material.Glass)
    end)

    grupo("blusa", function(g, tr)
        add(g, tr, CFrame.new(0,0.42,0), V3(1.96,1.10,1.06), COR.blusa)
        add(g, tr, CFrame.new(0,-0.20,0), V3(1.60,0.62,0.94), COR.blusa)
    end)

    grupo("saia", function(g, tr)
        add(g, tr, CFrame.new(0,-0.78,0), V3(0.52,2.06,2.06), COR.saia,
            Enum.PartType.Cylinder, P(0,0,90))
    end)
end

local function tirarRoupa(nome)
    local g = S.roupa[nome]
    if not g or not g.on then return end
    g.on = false
    for _, item in ipairs(g.parts) do
        local p = item.p
        if p and p.Parent then
            if item.w then item.w:Destroy() end
            p.Anchored=false; p.CanCollide=true; p.Massless=false; p.CastShadow=true
            p.AssemblyLinearVelocity = V3((rnd()-0.5)*3, 0.5+rnd()*2, (rnd()-0.5)*3)
            p.AssemblyAngularVelocity = V3((rnd()-0.5)*8,(rnd()-0.5)*8,(rnd()-0.5)*8)
            Debris:AddItem(p, 40)
        end
    end
    gemido("tirar"); som("roupa",0.3,0.9,1.2)
end

local function vestirRoupa(nome)
    local g = S.roupa[nome]
    if not g then return end
    for _, item in ipairs(g.parts) do if item.p and item.p.Parent then item.p:Destroy() end end
    g.parts = {}; g.on = true
    local tr = S.boneca and S.boneca.tronco; if not tr then return end
    g.builder(g, tr)
end

local function rasgarRoupa(nome)
    local g = S.roupa[nome]
    if not g or not g.on then return end
    g.on = false
    for _, item in ipairs(g.parts) do
        local p = item.p
        if p and p.Parent then
            local cf, sz = p.CFrame, p.Size
            local eixo = sz.X >= sz.Z and "X" or "Z"
            for s=-1,1,2 do
                local pedaco = Instance.new("Part")
                pedaco.Name="Rasgo"; pedaco.Color=p.Color; pedaco.Material=p.Material
                pedaco.Anchored=false; pedaco.CanCollide=true; pedaco.Massless=false; pedaco.CastShadow=true
                local off = eixo=="X" and V3(s*sz.X*0.25,0,0) or V3(0,0,s*sz.Z*0.25)
                pedaco.Size = eixo=="X" and V3(sz.X*0.5,sz.Y,sz.Z) or V3(sz.X,sz.Y,sz.Z*0.5)
                pedaco.CFrame = cf * CFrame.new(off)
                pedaco.Parent = WS
                local dir = (cf * CFrame.new(off*3)).Position - cf.Position
                pedaco.AssemblyLinearVelocity = dir.Unit*6 + V3(0,2+rnd()*2,0)
                pedaco.AssemblyAngularVelocity = V3((rnd()-0.5)*14,(rnd()-0.5)*14,(rnd()-0.5)*14)
                Debris:AddItem(pedaco, 45)
            end
            if item.w then item.w:Destroy() end
            p:Destroy()
        end
    end
    som("roupa",0.5,1.3,1.6); gemido("fala"); aviso("RASGOU!")
end

local function tirarTudo()
    for _, n in ipairs({"blusa","sutia","calcinha","saia"}) do
        task.spawn(function() tirarRoupa(n); task.wait(0.18) end)
    end
end

local function rasgarTudo()
    for _, n in ipairs({"blusa","sutia","calcinha","saia"}) do
        task.spawn(function() rasgarRoupa(n); task.wait(0.14) end)
    end
end

