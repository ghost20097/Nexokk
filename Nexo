--==================== LOOP ====================
local function ligarLoop()
    local conn = RunService.RenderStepped:Connect(function(rawdt)
        local dt = math.min(rawdt, 1/30)
        local char = LP.Character; if not char then return end
        local hrpJ = char:FindFirstChild("HumanoidRootPart"); if not hrpJ then return end
        local t = tick()

        atualizarFisio(dt)
        atualizarVergonha(dt)
        atualizarMasturbacao(dt)
        atualizarPrelim(dt)

        local look = hrpJ.CFrame.LookVector
        local flat = V3(look.X,0,look.Z); if flat.Magnitude<0.01 then flat=V3(0,0,-1) end; flat=flat.Unit
        local baseRot = CFrame.lookAt(V3(), flat)
        if S.raiva and S.aura and S.aura.Parent then S.aura.CFrame = hrpJ.CFrame end
        if not (S.boneca and S.boneca.model.Parent) then return end

        local pose = POSES[S.poseIdx]
        local a = S.tesao/100
        local br = sin(S.resp*pi*2)

        if S.sexo and S.picaWeld and S.picaWeld.Parent then
            local oral, chupa, vert = pose.oral, pose.chupar, pose.vertical
            local alvo = oral and "boca" or (chupa and "buceta" or S.alvo)
            local tl = alvoLocal(pose, alvo)
            local picaW = S.picaWeld.Part0.CFrame * S.picaBase
            local picaTip = (picaW*CFrame.new(0,S.picaL*1.02,0)).Position
            local axis = vert and V3(0,1,0) or (picaTip - picaW.Position).Unit
            local est = chupa and sin(t*2.4)*0.06 or abs(sin(t*S.vel))*S.amp
            local desiredRot = baseRot * pose.rot
            local pivot
            if chupa then
                local head = char:FindFirstChild("Head")
                pivot = head and (head.CFrame*CFrame.new(0,-0.35,-0.40)).Position or (hrpJ.CFrame*CFrame.new(0,1.2,-0.6)).Position
            elseif oral and pose.pivPica then pivot = picaW.Position + axis*(S.picaL*0.55)
            else pivot = picaTip end
            S.boneca.hrp.CFrame = CFrame.new(pivot - desiredRot*tl.Position - axis*est) * desiredRot * CFrame.new(0,S.ajY,S.ajZ)
            S.prof = est/math.max(0.001,S.amp)

            local gag = oral and clamp((S.prof-0.6)/0.4,0,1) or 0
            for sem,m in pairs(S.boneca.motores) do
                if m.Parent then
                    local extra = IDENT
                    if sem=="cabeca" then extra = P(-17*gag - 1.5*br,0,0) end
                    m.C0 = S.boneca.baseJ[sem] * (pose.motores[sem] or IDENT) * extra
                end
            end
            if S.boneca.bocaInf then
                local abre = oral and 0.30 or clamp(est*0.9,0,0.35)
                S.boneca.bocaInf.CFrame = S.boneca.cabeca.CFrame * CFrame.new(0,-0.47-abre*0.35,-0.65)
            end
            local abre = chupa and 0.40 or clamp(est*0.85,0,0.42)
            for _,l in ipairs(S.boneca.vulva.labios) do
                if l.w and l.w.Parent then l.w.C0 = l.base*CFrame.new(l.lado*abre*0.55,0,-abre*0.30) end
            end
            S.picaWeld.C0 = S.picaBase * CFrame.new(0,est*0.72,0)
            for _,p in ipairs(S.picaParts) do
                if p.Parent and p.Name~="Neko_Precum" then
                    local molhado = chupa and 0 or clamp(est/S.amp,0,1)
                    p.Material = molhado>0.35 and Enum.Material.Glass or Enum.Material.SmoothPlastic
                    p.Transparency = molhado*0.10
                end
            end
            if S.precum and S.precum.Parent then
                S.precum.CFrame = S.picaRaiz.CFrame*CFrame.new(0,S.picaL*1.18,-0.03)
                S.precum.Transparency = 1-S.ereccao
            end
            S.babaT = S.babaT + dt
            local lim = oral and 0.9 or 2.4
            if S.babaT > lim then
                S.babaT = 0
                if oral then gemido(rnd()<0.6 and "oral" or "normal")
                elseif chupa then gemido(rnd()<0.6 and "chupa" or "fala")
                else gemido(rnd()<0.25 and "fala" or (vert and "montar" or "normal")) end
            end
            if not chupa and not oral then
                S.somT = S.somT + dt
                if S.somT > 1/math.max(1,S.vel*0.9) then
                    S.somT = 0; som("estoc",0.35,0.85,1.2)
                    if S.molhada>0.4 then som("squish",0.3,0.8,1.25) end
                end
            end
            if oral then
                local mp = S.boneca.tronco.CFrame * alvoLocal(pose,"boca")
                S.engasgo = S.engasgo + dt
                if gag>0.5 and S.engasgo>0.5 then
                    S.engasgo=0; gemido("oral"); babar(mp.Position, V3((rnd()-0.5)*2,-1,(rnd()-0.5)*2))
                end
                if rnd()<0.22 then babar(mp.Position, V3((rnd()-0.5)*1.5,-2,(rnd()-0.5)*1.5)) end
                S.cuspeT = S.cuspeT + dt
                if S.cuspeT>1.6 then
                    S.cuspeT=0
                    local tip = (S.picaWeld.Part0.CFrame*S.picaBase*CFrame.new(0,S.picaL*0.9,0)).Position
                    local dir = tip-mp.Position
                    if dir.Magnitude>0.05 then fluido(mp.Position, dir.Unit*9, Color3.fromRGB(235,248,255),0.09,false) end
                end
            end
            if not oral and S.molhada>0.25 and rnd()<S.molhada*0.25 then
                local pv = S.boneca.tronco.CFrame*CFrame.new(0,-0.66,-0.68)
                gota(pv.Position, V3((rnd()-0.5)*1.2,-1.5,(rnd()-0.5)*1.2), COR.gota, true)
            end
            if chupa then
                S.mijaT = S.mijaT + dt
                if S.mijaT>1.0 then
                    S.mijaT=0
                    if rnd()<0.05 then mijar(); task.delay(1.4, function() eventoRaiva() end) end
                end
            end

        elseif S.prelim then
            local pos = V3(hrpJ.Position.X+flat.X*1.20, hrpJ.Position.Y-2.35+2.75, hrpJ.Position.Z+flat.Z*1.20)
            S.boneca.hrp.CFrame = CFrame.new(pos)*baseRot*P(0,180,0)*CFrame.new(0,br*0.015,0)
            for sem,m in pairs(S.boneca.motores) do
                if m.Parent then m.C0 = S.boneca.baseJ[sem] * (POSES[4].motores[sem] or IDENT) end
            end
            -- maos dela em voce
            local meuTorso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            if meuTorso then
                local rel = S.boneca.hrp.CFrame:PointToObjectSpace(meuTorso.Position)
                for _, lado in ipairs({-1,1}) do
                    local nm = lado>0 and "D" or "E"
                    local m1, m2 = S.boneca.motores["braco"..nm], S.boneca.motores["cotovelo"..nm]
                    local T = V3(rel.X + lado*0.42, rel.Y + 0.30 + sin(t*1.3+lado)*0.08, rel.Z + 0.10)
                    setIK(m1, m2, V3(lado*0.80,0.72,0), T, LEN_BRACO, LEN_ANTEBRACO, V3(lado*1.4,0.1,0.5))
                end
            end
            if S.beijo > 0.4 then
                local boca = S.boneca.tronco.CFrame * alvoLocal(POSES[4], "boca")
                if rnd()<0.35 then babar(boca.Position, V3((rnd()-0.5)*0.6, 0.3, (rnd()-0.5)*0.6)) end
            end

        elseif S.masturbando then
            local chao = hrpJ.Position.Y - 2.35
            local pos = V3(hrpJ.Position.X+flat.X*2.6, chao+0.62, hrpJ.Position.Z+flat.Z*2.6)
            local rot = CFrame.lookAt(V3(), flat)
            S.boneca.hrp.CFrame = CFrame.new(pos)*rot*P(0,180,0)*CFrame.new(0,br*0.02,0)
            local POSE_MAST = {
                raiz=P(-14,0,0), cabeca=P(16,0,0),
                quadrilE=P(88,0,-30), quadrilD=P(88,0,30),
                joelhoE=P(-84,0,0), joelhoD=P(-84,0,0),
                bracoE=P(60,0,-26), bracoD=P(18,0,10),
                cotoveloE=P(-70,0,0), cotoveloD=P(-30,0,0),
            }
            for sem,m in pairs(S.boneca.motores) do
                if m.Parent then
                    local extra = IDENT
                    if sem=="cabeca" then extra = P(-2*br,0,0) end
                    m.C0 = S.boneca.baseJ[sem] * (POSE_MAST[sem] or IDENT) * extra
                end
            end
            -- mao direita na buceta
            local m1, m2 = S.boneca.motores.bracoD, S.boneca.motores.cotoveloD
            local dedo = 0.5 + sin(t*3.4)*0.5
            local T = V3(0.10, -0.60, -0.62 - dedo*0.16)
            setIK(m1, m2, V3(0.80,0.72,0), T, LEN_BRACO, LEN_ANTEBRACO, V3(1.9,-0.1,0.6))
            for _, d in ipairs(S.dedos) do
                if d.w.Parent then d.w.C0 = d.base * P(38 + dedo*10, 0, 0) end
            end
            local abre = 0.30 + dedo*0.16
            for _,l in ipairs(S.boneca.vulva.labios) do
                if l.w and l.w.Parent then l.w.C0 = l.base*CFrame.new(l.lado*abre*0.55,0,-abre*0.30) end
            end
            S.mastOrg = S.mastOrg + dt
            if S.mastOrg > 2.2 then
                S.mastOrg = 0
                gemido(rnd()<0.6 and "mast" or "normal")
                if S.molhada > 0.45 and rnd()<0.4 then
                    local pv = S.boneca.tronco.CFrame*CFrame.new(0,-0.66,-0.68)
                    gota(pv.Position, V3((rnd()-0.5)*1.2,-1.5,(rnd()-0.5)*1.2), COR.gota, true)
                end
            end

        else
            local chaoY = hrpJ.Position.Y - 2.35
            local pos = V3(hrpJ.Position.X+flat.X*2.4, chaoY+2.75, hrpJ.Position.Z+flat.Z*2.4)
            S.boneca.hrp.CFrame = CFrame.new(pos)*baseRot*P(0,180,0)*CFrame.new(0,br*0.02,0)
            for sem,m in pairs(S.boneca.motores) do
                if m.Parent then
                    local extra = IDENT
                    if sem=="cabeca" then extra = P(-1.2*br,0,0) end
                    m.C0 = S.boneca.baseJ[sem] * (POSES[4].motores[sem] or IDENT) * extra
                end
            end
        end

        aplicarJigs(dt)
        atualizarMaos(dt)
        atualizarCabeca(dt)
        atualizarOlhos(dt)
        atualizarPes(dt)

        local respVel
        if S.sexo and S.tesao > 85 then respVel = 0.06
        else respVel = 0.28 + a*0.55 + S.vergonha*0.30 + (S.raiva and 0.35 or 0) end
        S.resp = S.resp + dt*respVel
        if S.realResp then
            local cost = S.boneca.tronco:FindFirstChild("Costelas")
            if cost then cost.Size = V3(1.72, 0.78+br*0.03, 0.94+br*0.05) end
        end

        S.pisca = S.pisca + dt
        if S.pisca > 2.6 + rnd()*2.4 then
            S.pisca = 0
            task.spawn(function()
                S.olhoFechado = math.max(S.olhoFechado, 1)
                task.wait(0.10)
                S.olhoFechado = 0
            end)
        end

        if S.trem > 0.12 then
            S.boneca.hrp.CFrame = S.boneca.hrp.CFrame*CFrame.new((rnd()-0.5)*0.03*S.trem,(rnd()-0.5)*0.03*S.trem,0)
        end
    end)
    S.conns[#S.conns+1] = conn
end

