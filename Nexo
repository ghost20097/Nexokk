        while g.Parent and tick()-t0<2.4 do
            v=v+V3(0,-30*(viscoso and 0.55 or 1),0)*dt
            if viscoso then v=v*0.982 end
            p=p+v*dt; g.CFrame=CFrame.new(p); passo=passo+1
