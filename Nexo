gozar = function()
    if not S.boneca then return end
    S.gozadas = S.gozadas + 1
    S.revirar = 1; S.olhoFechado = math.max(S.olhoFechado, 0.72)
    gemido("gozo"); som("gozo",0.7,0.9,1.2); S.contra = 1
    local p = S.boneca.tronco.CFrame * CFrame.new(0,-0.62,-0.70)
    local n = 22 + S.qual*8
    for i=1,n do
        task.spawn(function()
            task.wait(i*0.02)
            gota(p.Position, V3((rnd()-0.5)*4,2+rnd()*5,(rnd()-0.5)*4), COR.leite, true)
        end)
    end
    task.spawn(function()
        local t0 = tick()
        while tick()-t0 < 1.6 do
            local k = 1-(tick()-t0)/1.6; S.contra = k
            if S.canal and S.canal.Parent then
                S.canal.Size = V3(0.095, 0.24*(1+sin(tick()*28)*0.28*k), 0.24*(1+sin(tick()*28)*0.28*k))
